// Design Brooks — PostgreSQL schema (see architectural-studio-mvp-scope.md §16)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: pooled connection for the app, direct connection for migrations/DDL
  directUrl = env("DIRECT_URL")
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  INTERIOR_DESIGN
  RENOVATION
  OTHER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum DocumentCategory {
  ARCHITECTURAL
  STRUCTURAL
  ELECTRICAL
  PLUMBING
  RENDER_3D
  OTHER
}

enum AccessMode {
  RESTRICTED_PREVIEW
  FULL_ACCESS
}

enum DocumentStatus {
  READY
  PROCESSING
  FAILED
}

enum LinkStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  ARCHIVED
}

enum ActorType {
  ADMIN
  CLIENT
  SYSTEM
}

// ————— Single administrator —————
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String // scrypt(N, r, p) format: scrypt$N$r$p$salt$hash — never plaintext
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  documents    Document[]
}

// ————— Server-side session store —————
model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique // sha256 of the raw cookie token
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

// ————— Studio records —————
model Client {
  id            String    @id @default(uuid())
  fullName      String
  email         String?
  phone         String?
  company       String?
  location      String?
  internalNotes String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]

  @@index([email])
  @@index([archivedAt])
}

model Project {
  id          String        @id @default(uuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  reference   String?       @unique
  type        ProjectType   @default(RESIDENTIAL)
  location    String?
  description String?
  coverImage  String?
  status      ProjectStatus @default(DRAFT)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  documents   Document[]
  links       ProjectAccessLink[]
  activity    ActivityLog[]

  @@index([clientId, status])
  @@index([status])
}

model Document {
  id               String           @id @default(uuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  category         DocumentCategory @default(ARCHITECTURAL)
  originalFileName String
  storageKey       String           @unique // private object key — never a public URL
  previewKey       String?          @unique // watermarked preview key (restricted mode)
  mimeType         String
  fileSize         Int
  fileType         String           // uppercase extension label, e.g. PDF
  accessMode       AccessMode       @default(RESTRICTED_PREVIEW)
  revision         String           @default("Rev A")
  status           DocumentStatus   @default(READY)
  failureReason    String?
  uploadedById     String?
  uploadedBy       AdminUser?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  archivedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([projectId, category])
  @@index([accessMode])
}

model ProjectAccessLink {
  id            String      @id @default(uuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique // sha256 of the raw token — raw token shown only at creation
  status        LinkStatus  @default(ACTIVE)
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  revokedAt     DateTime?
  lastAccessedAt DateTime?
  openCount     Int         @default(0)

  @@index([projectId, status])
}

model Inquiry {
  id          String        @id @default(uuid())
  name        String
  email       String
  phone       String?
  service     String
  location    String?
  description String?
  status      InquiryStatus @default(NEW)
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([isRead, status])
}

model ActivityLog {
  id           String    @id @default(uuid())
  actorType    ActorType
  adminId      String?
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  documentId   String?
  accessLinkId String?
  action       String
  detail       String
  metadata     String? // compact JSON string
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([projectId])
}

model Setting {
  key       String   @id
  value     String // JSON payload
  updatedAt DateTime @updatedAt
}
