# ————— Design Brooks — environment template —————
# Copy to .env (local dev) and fill in real values. NEVER commit .env.
# Production: set these in the Vercel project settings (Production environment).

# ————— Database —————
# Neon: POOLED connection for the app — hostname contains "-pooler".
#   postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.eu-west-2.aws.neon.tech/DB?sslmode=require
# Local Docker dev uses localhost:5434; DIRECT_URL then mirrors DATABASE_URL.
DATABASE_URL=

# Neon: DIRECT connection — same credentials, hostname WITHOUT "-pooler".
#   postgresql://USER:PASSWORD@ep-xxxx-xxxx.eu-west-2.aws.neon.tech/DB?sslmode=require
# Used by `prisma migrate deploy` (schema changes). Local dev: same value as DATABASE_URL.
DIRECT_URL=

# ————— App —————
# Public base URL — used to build client project links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ————— File storage —————
# Local dev (default): private disk under ./data/storage — nothing to configure.
# Production (Cloudflare R2, S3-compatible, private bucket):
#   R2_ACCOUNT_ID = Cloudflare account ID (dashboard URL / R2 overview)
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY = R2 > Manage API Tokens > Create Token
#   R2_BUCKET_NAME = the private bucket (no public access)
#   R2_ENDPOINT = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# For local dev you may leave these empty to use the disk fallback.
STORAGE_DIR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# ————— Email (optional, future) —————
RESEND_API_KEY=
EMAIL_FROM=hello@designbrooks.com

# ————— One-time admin seed (npm run seed:admin) —————
# Only used when creating the single admin account. Defaults shown; override as needed.
# The seed generates a strong temporary password unless ADMIN_PASSWORD is set.
ADMIN_EMAIL=admin@designbrooks.com
ADMIN_NAME=Design Brooks
